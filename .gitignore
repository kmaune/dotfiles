.netrwhist
autoload/plug.vim
plugged/
tmux/plugins/*
!tmux/plugins/tpm
.DS_Store
**/.DS_Store
*/.DS_Store
ssh/sshd_config.d/999-local.conf

# SSH Security - Never commit private keys or sensitive configs
ssh/sshd_config.d/999-local.conf
ssh/known_hosts
ssh/*_key
ssh/id_*
!ssh/*.pub
**/*_key
**/id_*
!**/*.pub
*.pem

# Homebrew - Keep personal packages private
homebrew/Brewfile.personal
homebrew/Brewfile.backup.*

# Claude Code internal data (runtime generated)
claude/projects/
claude/shell-snapshots/
claude/statsig/
claude/todos/
claude/.update.lock

# temp directories
_temp/

# Claude runtime/ephemeral state
claude/backups/
claude/debug/
claude/cache/
claude/history.jsonl
claude/paste-cache/
claude/sessions/
claude/file-history/
claude/plans/
