{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "LS",
      "MultiEdit",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "ignorePatterns": [
    "**/build/**",
    "**/cmake-build-*/**",
    "**/.cache/**",
    "**/node_modules/**",
    "**/venv/**",
    "**/env/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/*.pyo",
    "**/target/**",
    "**/*.o",
    "**/*.a",
    "**/*.so",
    "**/*.dylib",
    "**/*.exe",
    "**/compile_commands.json",
    "**/.vscode/**",
    "**/.idea/**",
    "**/CMakeFiles/**",
    "**/CMakeCache.txt",
    "**/*.log",
    "**/core",
    "**/core.*",
    "**/.git/**",
    "**/.DS_Store"
  ]
}
